#!/bin/bash
#
# create-DNS-updater FQDN [--profile=P] [--new-key] [--invalidate-old-keys] [--force]
#
# Creates (idempotently) an IAM user "<fqdn-with-dashes>-updater" scoped — via
# principal tags plus a generic ABAC policy — to change exactly the one DNS
# record <FQDN> in its Route53 zone, then prints `export` lines for its key.
#
# The user name derives from the WHOLE FQDN, not just its first label: two
# servers whose names share a first label (collaborate.a.com, collaborate.b.com)
# would otherwise map to one IAM user, and the tag-user call below would
# silently re-point it at the second FQDN, breaking the first server with no
# error anywhere but its ddclient log.
#
#   --profile=P   AWS CLI profile for YOUR admin creds (passed to `aws`);
#                 omit to use AWS_PROFILE / the default profile / env vars.
#   --new-key     create a new access key, leaving existing keys in place.
#                 (A brand-new user always gets a key without this flag.)
#   --invalidate-old-keys
#                 delete the user's existing access key(s). Combine with
#                 --new-key to rotate (remove old, mint new).
#   --force       re-tag a user that is currently tagged for a different FQDN.
#                 Without it, that case is a hard error rather than a silent
#                 hijack of another server's updater.
#
set -euo pipefail

PROFILE=""
NEW_KEY=""
INVALIDATE=""
FORCE=""
FQDN=""

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile=*)           PROFILE="${1#*=}"; shift;;
    --profile)             PROFILE="${2:?}"; shift 2;;
    --new-key)             NEW_KEY=1; shift;;
    --invalidate-old-keys) INVALIDATE=1; shift;;
    --force)               FORCE=1; shift;;
    -h|--help)             usage; exit 0;;
    -*)                    echo "unknown option: $1" >&2; usage; exit 1;;
    *)                     FQDN="$1"; shift;;
  esac
done

[[ -n "$FQDN" && "$FQDN" == *.* ]] || { echo "Usage: $0 FQDN [--profile=P] [--new-key]" >&2; exit 1; }

AWS=(aws)
[[ -n "$PROFILE" ]] && AWS+=(--profile "$PROFILE")

HOST="${FQDN%%.*}"
DOMAIN="${FQDN#*.}"
USER="${FQDN//./-}-updater"
echo "FQDN=$FQDN  host=$HOST  domain=$DOMAIN  user=$USER" >&2

# Look up the hosted-zone id for the domain
ZONE_ID="$("${AWS[@]}" route53 list-hosted-zones \
            --query "HostedZones[?Name=='${DOMAIN}.'].Id | [0]" --output text | cut -d/ -f3)"
[[ -n "$ZONE_ID" && "$ZONE_ID" != "None" ]] || { echo "error: no Route53 hosted zone for '${DOMAIN}.'" >&2; exit 1; }
echo "hosted zone: $ZONE_ID" >&2

# Generic ABAC policy — the per-user scoping comes from the FQDN/HostedZone
# tags set below, not from this document, so it is fully static.
POLICY="$(mktemp)"; trap 'rm -f "$POLICY"' EXIT
cat > "$POLICY" <<'JSON'
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets",
        "route53:GetHostedZone"
      ],
      "Resource": "arn:aws:route53:::hostedzone/${aws:PrincipalTag/HostedZone}"
    },
    {
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::change/*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": "${aws:PrincipalTag/FQDN}"
        }
      }
    }
  ]
}
JSON

# Create the user if needed; always (re)apply tags and the inline policy
if ! "${AWS[@]}" iam get-user --user-name "$USER" >/dev/null 2>&1; then
  echo "Creating user $USER ..." >&2
  "${AWS[@]}" iam create-user --user-name "$USER" >/dev/null
else
  # Refuse to hijack an updater that is currently scoped to a different record.
  # The tag-user below is unconditional, so without this check a name clash
  # re-points an in-use user and silently breaks whichever server had it first.
  PRIOR_FQDN="$("${AWS[@]}" iam list-user-tags --user-name "$USER" \
                  --query "Tags[?Key=='FQDN'].Value | [0]" --output text 2>/dev/null || true)"
  if [[ -n "$PRIOR_FQDN" && "$PRIOR_FQDN" != "None" && "$PRIOR_FQDN" != "$FQDN" ]]; then
    if [[ -z "$FORCE" ]]; then
      echo "error: user $USER is tagged for '$PRIOR_FQDN', not '$FQDN'." >&2
      echo "       Re-tagging would break whatever server uses it. Pass --force to override." >&2
      exit 1
    fi
    echo "WARNING: re-tagging $USER from '$PRIOR_FQDN' to '$FQDN' (--force)" >&2
  fi
fi
"${AWS[@]}" iam tag-user --user-name "$USER" \
    --tags "Key=FQDN,Value=${FQDN}" "Key=HostedZone,Value=${ZONE_ID}"
"${AWS[@]}" iam put-user-policy --user-name "$USER" \
    --policy-name UpdateSpecificDNSRecord --policy-document "file://$POLICY"

# Access key. --invalidate-old-keys removes existing keys; --new-key (or a
# brand-new user with no key) mints one. The two are independent.
EXISTING="$("${AWS[@]}" iam list-access-keys --user-name "$USER" \
            --query 'AccessKeyMetadata[].AccessKeyId' --output text 2>/dev/null || true)"

if [[ -n "$EXISTING" && -n "$INVALIDATE" ]]; then
  for k in $EXISTING; do
    echo "Deleting old access key $k ..." >&2
    "${AWS[@]}" iam delete-access-key --user-name "$USER" --access-key-id "$k"
  done
fi

if [[ -n "$NEW_KEY" || -z "$EXISTING" ]]; then
  read -r AK_ID AK_SECRET < <("${AWS[@]}" iam create-access-key --user-name "$USER" \
      --query 'AccessKey.[AccessKeyId,SecretAccessKey]' --output text)
  echo "export AWS_ACCESS_KEY_ID=$AK_ID"
  echo "export AWS_SECRET_ACCESS_KEY=$AK_SECRET"
elif [[ -n "$INVALIDATE" ]]; then
  echo "NOTE: deleted old key(s); no new key created (pass --new-key to mint one)." >&2
else
  echo "NOTE: $USER already has access key(s): $EXISTING" >&2
  echo "      --new-key to add one; --invalidate-old-keys to remove them." >&2
fi
